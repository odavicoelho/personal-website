---
import '../styles/global.css';
import type { PageId } from '../i18n/types';
import { getContent, htmlLang, isEngineering, pathFor } from '../i18n/utils';
import { site } from '../config/site';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const t = getContent(page);

const canonical = new URL(pathFor(page), Astro.site);
const ogImage = new URL(`/og-${page}.png`, Astro.site);
// the two engineering pages are translations of each other
const alternates = isEngineering(page)
  ? [
      { hreflang: 'en', href: new URL(pathFor('en'), Astro.site) },
      { hreflang: 'pt-BR', href: new URL(pathFor('pt'), Astro.site) },
      { hreflang: 'x-default', href: new URL(pathFor('en'), Astro.site) },
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: canonical.href,
  email: `mailto:${site.email}`,
  jobTitle: t.pillars.map((p) => p.title),
  address: { '@type': 'PostalAddress', addressCountry: 'BR' },
  sameAs: [site.linkedin, site.x, site.github].filter(Boolean),
};
---

<!doctype html>
<html lang={htmlLang(page)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0f" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={htmlLang(page) === 'en' ? 'en_US' : 'pt_BR'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
