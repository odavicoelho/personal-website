---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Pillars from './Pillars.astro';
import About from './About.astro';
import Skills from './Skills.astro';
import Projects from './Projects.astro';
import Tutoring from './Tutoring.astro';
import Plans from './Plans.astro';
import Engineering from './Engineering.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { PageId } from '../i18n/types';
import { isEngineering } from '../i18n/utils';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
---

<Base page={page}>
  <Nav page={page} />
  <main>
    <Hero page={page} />
    <Pillars page={page} />
    {
      isEngineering(page) ? (
        <>
          <About page={page} />
          <Skills page={page} />
          <Projects page={page} />
        </>
      ) : (
        <>
          <Tutoring page={page} />
          <Plans page={page} />
          <About page={page} />
          <Engineering page={page} />
        </>
      )
    }
    <Contact page={page} />
  </main>
  <Footer page={page} />
</Base>
