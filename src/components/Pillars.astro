---
import Icon from './Icon.astro';
import type { PageId } from '../i18n/types';
import { getContent } from '../i18n/utils';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const t = getContent(page);
const cols = t.pillars.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';
---

<div class="mx-auto -mt-4 max-w-6xl px-4 sm:px-6">
  <div class:list={['grid gap-4', cols]}>
    {
      t.pillars.map((p, i) => (
        <article data-reveal style={`--delay: ${i * 100}ms`} class="glow-card p-6">
          <div class="mb-5 grid size-12 place-items-center rounded-xl border border-accent/30 bg-accent/10 text-accent">
            <Icon name={p.icon} class="size-6" />
          </div>
          <h2 class="font-display text-xl font-semibold text-white">{p.title}</h2>
          <p class="mt-2 leading-relaxed text-muted">{p.description}</p>
        </article>
      ))
    }
  </div>
</div>
