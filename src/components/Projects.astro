---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import type { PageId } from '../i18n/types';
import { getContent } from '../i18n/utils';
import { site } from '../config/site';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const t = getContent(page).projects;
---

{
  t && (
<section id="projects" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeader kicker={t.kicker} title={t.title} />

  {t.items.map((p, i) => (
    <article data-reveal style={`--delay: ${i * 80}ms`} class="glow-card mb-6 grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-12">
      <div class="flex flex-col">
        {p.status && (
          <p class="inline-flex items-center gap-2 self-start rounded-full border border-line bg-white/[0.03] px-3 py-1 text-xs text-muted">
            <span class="pulse-dot size-2 rounded-full bg-green-400" />
            {p.status}
          </p>
        )}
        <h3 class="mt-4 font-display text-2xl font-semibold text-white sm:text-3xl">{p.title}</h3>
        <p class="mt-2 text-lg text-accent-soft">{p.tagline}</p>
        <p class="mt-4 leading-relaxed text-fg/85">{p.description}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {p.tags.map((tag) => (
            <li class="rounded-md bg-accent/10 px-2 py-0.5 font-mono text-xs text-accent-soft">{tag}</li>
          ))}
        </ul>
        <div class="mt-auto flex flex-col gap-3 pt-8 sm:flex-row">
          {p.liveUrl && (
            <a href={p.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
              {t.labels.live}
              <Icon name="external" class="size-4" />
            </a>
          )}
          {p.repoUrl && (
            <a href={p.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">
              <Icon name="github" class="size-5" />
              {t.labels.repo}
            </a>
          )}
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="glass p-5">
          <h4 class="kicker">{t.labels.problem}</h4>
          <p class="mt-3 leading-relaxed text-fg/90">{p.problem}</p>
        </div>
        <div class="glass p-5">
          <h4 class="kicker">{t.labels.value}</h4>
          <ul class="mt-3 space-y-2.5">
            {p.value.map((v) => (
              <li class="flex gap-3 leading-relaxed text-fg/90">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" />
                {v}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>
  ))}

  <div data-reveal class:list={['flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between', t.items.length === 0 ? 'glow-card p-6 sm:p-8' : 'glass p-5 sm:p-6']}>
    <div class="max-w-2xl">
      <p class="inline-flex items-center gap-2 font-mono text-xs tracking-wider text-accent uppercase">
        <span class="pulse-dot size-2 rounded-full bg-accent" />
        {t.building.title}
      </p>
      <p class:list={['mt-3 leading-relaxed text-fg/85', t.items.length === 0 && 'text-lg']}>{t.building.text}</p>
    </div>
    <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn-ghost shrink-0">
      <Icon name="github" class="size-5" />
      {t.building.cta}
    </a>
  </div>

  <h3 data-reveal class="mt-20 mb-8 font-display text-2xl font-semibold text-white">{t.experienceTitle}</h3>
  <ol class="relative space-y-8 border-l border-line pl-6 sm:pl-8">
    {
      t.experience.map((job, i) => (
        <li data-reveal style={`--delay: ${i * 80}ms`} class="relative">
          <span class="absolute top-1.5 -left-[1.95rem] size-3 rounded-full border-2 border-accent bg-bg shadow-[0_0_12px_var(--color-accent)] sm:-left-[2.45rem]" />
          <p class="font-mono text-xs tracking-wider text-accent uppercase">{job.period}</p>
          <p class="mt-1 font-display text-lg font-semibold text-white">
            {job.role}
            {job.company && <span class="font-normal text-muted">· {job.company}</span>}
          </p>
          <p class="mt-1 text-muted">{job.description}</p>
        </li>
      ))
    }
  </ol>
</section>
  )
}
