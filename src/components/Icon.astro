};

const isFilled = filled.has(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={paths[name]}
/>
