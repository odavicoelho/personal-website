---
// Inline SVG icon set. Stroke icons follow the Lucide style; brand icons are filled.
export type IconName =
  | 'linkedin'
  | 'x'
  | 'whatsapp'
  | 'mail'
  | 'github'
  | 'code'
  | 'data'
  | 'teach'
  | 'arrow'
  | 'external'
  | 'copy'
  | 'menu'
  | 'close'
  | 'globe'
  | 'pin';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

const filled = new Set(['linkedin', 'x', 'whatsapp', 'github']);

