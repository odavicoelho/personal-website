---
import Icon from './Icon.astro';
import type { PageId } from '../i18n/types';
import { brokerFor, engineeringFor, getContent, hasTranslation, htmlLang, langCode, pathFor, switchTarget } from '../i18n/utils';
import { site } from '../config/site';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const t = getContent(page);
const home = pathFor(page);
const target = switchTarget(page);
const switchHref = pathFor(target);
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={home} class="flex items-center gap-2 font-display text-lg font-semibold text-white" aria-label={site.name}>
      <span class="grid size-9 place-items-center rounded-lg border border-accent/40 bg-accent/10 font-mono text-sm text-accent">
        {site.initials}
      </span>
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        t.nav.map((item) => (
          <a href={`#${item.id}`} data-nav-link class="nav-link rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-white">
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1.5 sm:gap-2">
      {
        t.tutoringLink && (
          <a
            href={pathFor('aulas')}
            aria-label={t.tutoringLink.aria}
            class="inline-flex h-10 items-center gap-1.5 rounded-lg border border-line bg-white/[0.03] px-3 font-mono text-xs text-fg transition-colors hover:border-accent/50 hover:text-accent"
          >
            <Icon name="teach" class="size-4 text-accent" />
            <span>{t.tutoringLink.label}</span>
          </a>
        )
      }
      {
        t.engineeringLink && (
          <a
            href={pathFor(engineeringFor(page))}
            aria-label={t.engineeringLink.aria}
            class="inline-flex h-10 items-center gap-1.5 rounded-lg border border-line bg-white/[0.03] px-3 font-mono text-xs text-fg transition-colors hover:border-accent/50 hover:text-accent"
          >
            <Icon name="code" class="size-4 text-accent" />
            <span>{t.engineeringLink.label}</span>
          </a>
        )
      }
      {
        t.brokerLink && (
          <a
            href={pathFor(brokerFor(page))}
            aria-label={t.brokerLink.aria}
            class="inline-flex h-10 items-center gap-1.5 rounded-lg border border-line bg-white/[0.03] px-3 font-mono text-xs text-fg transition-colors hover:border-accent/50 hover:text-accent"
          >
            <Icon name="search" class="size-4 text-accent" />
            <span>{t.brokerLink.label}</span>
          </a>
        )
      }
      <a
        href={switchHref}
        data-lang-switch={hasTranslation(page) ? '' : undefined}
        hreflang={htmlLang(target)}
        aria-label={t.langSwitch.aria}
        class="inline-flex h-10 items-center gap-1.5 rounded-lg border border-line bg-white/[0.03] px-3 font-mono text-xs text-fg transition-colors hover:border-accent/50 hover:text-accent"
      >
        {
          hasTranslation(page) ? (
            <>
              <Icon name="globe" class="hidden size-4 sm:block" />
              <span class="text-accent">{langCode(page)}</span>
              <span class="text-muted">/</span>
              <span>{t.langSwitch.label}</span>
            </>
          ) : (
            <>
              <Icon name="code" class="size-4 text-accent" />
              <span>{t.langSwitch.label}</span>
            </>
          )
        }
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="group relative z-[60] grid size-10 place-items-center rounded-lg border border-line bg-white/[0.03] text-fg md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t.menu.open}
        data-label-open={t.menu.open}
        data-label-close={t.menu.close}
      >
        <Icon name="menu" class="size-5 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-5 group-aria-expanded:block" />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-open="false"
    class="fixed inset-0 z-50 flex flex-col justify-center bg-bg/95 px-8 backdrop-blur-xl md:hidden"
  >
    <ul class="space-y-2">
      {
        t.nav.map((item, i) => (
          <li>
            <a href={`#${item.id}`} class="flex items-baseline gap-4 py-3 font-display text-3xl font-semibold text-white">
              <span class="font-mono text-sm text-accent">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    {
      t.brokerLink && (
        <a href={pathFor(brokerFor(page))} class="mt-10 inline-flex items-center gap-3 font-mono text-sm text-accent">
          <Icon name="search" class="size-5" />
          {t.brokerLink.aria}
          <Icon name="arrow" class="size-4" />
        </a>
      )
    }
  </div>
</header>

<style>
  /* The blur lives on a pseudo-element: backdrop-filter on the header itself
     would become the containing block of the fixed mobile menu and clip it. */
  #site-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(10 10 15 / 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-line);
    opacity: 0;
    transition: opacity 0.3s;
  }
  #site-nav:global(.is-scrolled)::before {
    opacity: 1;
  }
  .nav-link:global(.is-active) {
    color: var(--color-accent);
  }
  #mobile-menu {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s,
      visibility 0.25s;
  }
  #mobile-menu[data-open='true'] {
    opacity: 1;
    visibility: visible;
  }
</style>
