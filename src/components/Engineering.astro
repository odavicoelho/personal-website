---
import Icon from './Icon.astro';
import type { PageId } from '../i18n/types';
import { getContent, pathFor } from '../i18n/utils';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const t = getContent(page).engineering;
---

{
  t && (
    <section id="engineering" class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
      <div data-reveal class="glow-card flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="flex gap-5">
          <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-accent/30 bg-accent/10 text-accent">
            <Icon name="code" class="size-6" />
          </span>
          <div class="max-w-2xl">
            <p class="kicker">{t.kicker}</p>
            <h2 class="mt-2 font-display text-xl font-semibold text-white">{t.title}</h2>
            <p class="mt-2 leading-relaxed text-muted">{t.text}</p>
          </div>
        </div>
        <a href={pathFor('pt')} class="btn-ghost shrink-0">
          {t.cta}
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </section>
  )
}
