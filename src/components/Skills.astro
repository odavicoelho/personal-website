---
import SectionHeader from './SectionHeader.astro';
import type { PageId } from '../i18n/types';
import { getContent } from '../i18n/utils';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const t = getContent(page).skills;
---

{
  t && (
<section id="skills" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeader kicker={t.kicker} title={t.title} />

  <div class="grid gap-4 sm:grid-cols-2">
    {
      t.groups.map((g, i) => (
        <div data-reveal style={`--delay: ${i * 80}ms`} class="glow-card p-6">
          <h3 class="font-mono text-sm text-accent">
            <span class="text-muted">// </span>
            {g.name}
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {g.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
  )
}
